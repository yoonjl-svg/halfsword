diff -ruN wa/src/body_read.js wf/src/body_read.js
--- wa/src/body_read.js	1970-01-01 00:00:00.000000000 +0000
+++ wf/src/body_read.js	2026-11-21 13:31:42.302852990 +0000
@@ -0,0 +1,77 @@
+// 몸 읽기 저장 — 한 물리 스텝 안에서 같은 몸의 자리·돌림·속도를 엔진에서 거듭 읽지 않는다.
+//  값이 바뀔 수 있는 때에 버린다: world.step 과 몸 수 · 충돌체 수를 바꾸는 부름은 모두(전체), 그 몸 자신의 바꾸는 부름은 그 몸만.
+//  힘 더하기(addForce · addTorque · addForceAtPoint · resetForces · resetTorques) · wakeUp · 관절 모터는 스텝 전엔 몸 값을 바꾸지 않아 버리지 않는다.
+//  돌려주는 값은 늘 새 객체 (부른 쪽이 고쳐 써도 저장 값은 그대로). 스텝 안(충돌 훅)에서는 저장을 쓰지 않는다.
+const K = Symbol('bodyRead');
+let gen = 1; // 전체 세대 — 올리면 모든 몸의 저장이 낡는다
+let busy = 0; // 엔진 안(스텝 · 몸 만들기/없애기)이면 저장을 쓰지 않는다
+
+const RB_PURE = new Set(('isValid dominanceGroup additionalSolverIterations softCcdPrediction nextTranslation nextRotation gravityScale ' +
+  'velocityAtPoint mass effectiveInvMass invMass localCom invPrincipalInertia principalInertia principalInertiaLocalFrame ' +
+  'effectiveWorldInvInertia effectiveAngularInertia isCcdEnabled numColliders collider isEnabled bodyType isSleeping isMoving ' +
+  'isFixed isKinematic isDynamic linearDamping angularDamping userForce userTorque ' +
+  'addForce addTorque addForceAtPoint resetForces resetTorques wakeUp').split(' '));
+const WORLD_PURE = new Set(('timestep lengthUnit numSolverIterations numInternalPgsIterations maxCcdSubsteps getRigidBody getCollider ' +
+  'getImpulseJoint getMultibodyJoint forEachCollider forEachRigidBody forEachActiveRigidBody castRay castRayAndGetNormal ' +
+  'intersectionsWithRay intersectionWithShape projectPoint projectPointAndGetFeature intersectionsWithPoint castShape ' +
+  'intersectionsWithShape collidersWithAabbIntersectingAabb contactPairsWith intersectionPairsWith contactPair intersectionPair ' +
+  'len contains get forEach getAll forEachJointHandleAttachedToRigidBody castClosure').split(' '));
+const COL_PURE = new Set(('isValid translation translationWrtParent rotation rotationWrtParent isSensor isEnabled frictionCombineRule ' +
+  'restitutionCombineRule contactSkin activeHooks activeEvents activeCollisionTypes contactForceEventThreshold shapeType halfExtents ' +
+  'radius roundRadius halfHeight parent friction restitution density mass volume collisionGroups solverGroups containsPoint ' +
+  'projectPoint intersectsRay castShape castCollider intersectsShape contactShape contactCollider castRay castRayAndGetNormal').split(' '));
+
+const methods = (P) => Object.getOwnPropertyNames(P).filter((m) => m !== 'constructor' && typeof Object.getOwnPropertyDescriptor(P, m).value === 'function');
+
+export function installBodyRead(R) {
+  const P = R.RigidBody.prototype;
+  if (P[K]) return;
+  P[K] = null;
+  const V = R.Vector3, Q = R.Quaternion;
+  const slot = (b) => {
+    let c = b[K];
+    if (c === null || c === undefined || c.g !== gen) c = b[K] = { g: gen, t: null, r: null, l: null, a: null, m: null };
+    return c;
+  };
+  const vec = (key, o) => function () {
+    if (busy) return o.call(this);
+    const c = slot(this), s = c[key];
+    if (s !== null) return new V(s[0], s[1], s[2]);
+    const v = o.call(this);
+    c[key] = [v.x, v.y, v.z];
+    return v;
+  };
+  const oRot = P.rotation;
+  P.rotation = function () {
+    if (busy) return oRot.call(this);
+    const c = slot(this), s = c.r;
+    if (s !== null) return new Q(s[0], s[1], s[2], s[3]);
+    const q = oRot.call(this);
+    c.r = [q.x, q.y, q.z, q.w];
+    return q;
+  };
+  P.translation = vec('t', P.translation);
+  P.linvel = vec('l', P.linvel);
+  P.angvel = vec('a', P.angvel);
+  P.worldCom = vec('m', P.worldCom);
+  // 그 밖의 몸 부름: 바꿀 수 있으니 그 몸 저장만 버린다
+  for (const m of methods(P)) {
+    if (RB_PURE.has(m) || m === 'translation' || m === 'rotation' || m === 'linvel' || m === 'angvel' || m === 'worldCom') continue;
+    const o = P[m];
+    P[m] = function (...a) { this[K] = null; return o.apply(this, a); };
+  }
+  // 엔진 전체를 바꿀 수 있는 부름: 앞뒤로 세대를 올리고 그동안 저장을 쓰지 않는다
+  const wide = (Proto, pure) => {
+    for (const m of methods(Proto)) {
+      if (pure.has(m)) continue;
+      const o = Proto[m];
+      Proto[m] = function (...a) {
+        gen++; busy++;
+        try { return o.apply(this, a); } finally { busy--; gen++; }
+      };
+    }
+  };
+  wide(R.World.prototype, WORLD_PURE);
+  for (const s of ['RigidBodySet', 'ColliderSet', 'ImpulseJointSet', 'MultibodyJointSet']) if (R[s]) wide(R[s].prototype, WORLD_PURE);
+  wide(R.Collider.prototype, COL_PURE);
+}
