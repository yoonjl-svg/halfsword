--- base/src/self_contact.js	2026-11-21 10:49:22.000000000 +0000
+++ wb/src/self_contact.js	2026-11-21 11:52:44.650680925 +0000
@@ -31,6 +31,46 @@
 /** 날아간 투구: 땅하고만 */
 export const HELMET_GROUPS = groups(BIT.helmet, BIT.ground);
 
+/**
+ * 자리 비트 (엔진 안에서 제 몸 쌍 버리기 — 걸이 부름 줄이기). 남은 비트로 앞 SLOTS 명만 자리를 받고, 그 뒤는 걸이(pairAllowed)로 — 사람 수 제한 없음.
+ *  자리 k: 몸 B_k · 칼 W_k (부류 비트 몸 2 · 칼 4 대신). 함께 쓰는 비트: 몸통 T · 칼팔 A · 제 칼(self 칼) WS.
+ *  거름의 몸·칼 부류는 '남의' 자리 비트까지 넓힌다 (자리 없는 싸움꾼·땅은 모두). 제 몸통 ↔ 제 칼팔(T·A) · 제 몸통 ↔ 제 칼(T·WS)만 남긴다.
+ *  test(slotGroups(a), slotGroups(b)) === test(부류 a, 부류 b) && pairAllowed(a, b) — tools/sim 밖 검사(모든 부류·self·자리 조합)로 확인
+ */
+const SB = Object.freeze({ torso: 8, arm: 16, ws: 128 });
+export const SLOTS = 4;
+const slotB = (k) => 256 << (2 * k);
+const slotW = (k) => 512 << (2 * k);
+let ALL_B = 0, ALL_W = 0;
+for (let k = 0; k < SLOTS; k++) { ALL_B |= slotB(k); ALL_W |= slotW(k); }
+/** 칼 부류 비트 전부 (revive.js 유령 '남의 칼' — 자리 칼 · 제 칼 WS 포함) */
+export const WEAPON_MASK = BIT.weapon | ALL_W | SB.ws;
+const _slots = new WeakMap();
+/** 세계마다 앞에서부터 자리 하나 (다 차면 null = 걸이) */
+export function takeSlot(world) {
+  const n = _slots.get(world) ?? 0;
+  if (n >= SLOTS) return null;
+  _slots.set(world, n + 1);
+  return n;
+}
+/** 부류 그룹 g · 제 몸 부류 self · 자리 k(null = 자리 없음) → 실제 충돌 그룹 */
+export function slotGroups(g, self, k) {
+  const m = g >>> 16, f = g & 0xffff;
+  const own = k == null ? 0 : slotB(k) | slotW(k);
+  let fo = f & ~(BIT.body | BIT.weapon);
+  if (f & BIT.body) fo |= BIT.body | (ALL_B & ~own);
+  if (f & BIT.weapon) fo |= BIT.weapon | (ALL_W & ~own) | (k == null ? SB.ws : 0);
+  if (k == null) return ((m << 16) | fo) >>> 0;
+  let mo = m & ~(BIT.body | BIT.weapon);
+  if (m & BIT.body) mo |= slotB(k);
+  if (m & BIT.weapon) mo |= slotW(k) | (self === SELF_WEAPON ? SB.ws : 0);
+  if (self === SELF_TORSO) { mo |= SB.torso; fo |= SB.arm | SB.ws; }
+  else if (self === SELF_ARM) { mo |= SB.arm; fo |= SB.torso; }
+  else if (self === SELF_WEAPON) fo |= SB.torso;
+  return ((mo << 16) | fo) >>> 0;
+}
+const SELF_TORSO = 1, SELF_ARM = 2, SELF_WEAPON = 4; // 아래 SELF 와 같은 값
+
 /** 제 몸 부류 (colliderInfo.self) — 제 몸통 ↔ 제 칼팔 · 제 몸통 ↔ 제 칼만 부딪힌다 */
 export const SELF = Object.freeze({ none: 0, torso: 1, arm: 2, weapon: 4 });
 const TORSO_ARM = SELF.torso | SELF.arm;
