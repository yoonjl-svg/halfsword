+const put = (o, v) => ((o.x = v.x), (o.y = v.y), (o.z = v.z), o);
+const putQ = (o, q) => ((o.x = q.x), (o.y = q.y), (o.z = q.z), (o.w = q.w), o);
+/** captureVitalPose 와 같은 값을 o(앞서 이 함수가 만든 사본 · 없으면 새로)에 고쳐 쓴다 — 반응 지연 기록 칸마다 하나 (ai_sense.js · 매 스텝 새 객체를 만들지 않게) */
+export function captureVitalPoseInto(f, o) {
+  if (!f?.bodies?.head || !f.bodies.chest || !f.bodies.pelvis) return null;
+  o ||= { targetId: 0, state: null, alive: false, armed: false, headOff: false, head: {}, chest: {}, pelvis: {}, headQ: {}, chestQ: {}, headRadius: 0, hasHelmet: false, neck: {}, face: {}, bladeBase: null, bladeTip: null };
+  const B = (_blade.get(o) ?? _blade.set(o, [{}, {}]).get(o)); // 칼 두 점 그릇 (키를 늘리지 않게 밖에)
+  const head = put(o.head, f.bodies.head.translation());
+  const headQ = putQ(o.headQ, f.bodies.head.rotation());
+  putQ(o.chestQ, f.bodies.chest.rotation());
+  o.targetId = f.index; o.state = f.state; o.alive = !!f.alive; o.armed = !!f.armed; o.headOff = !!f.decapitated;
+  put(o.chest, f.bodies.chest.translation());
+  put(o.pelvis, f.bodies.pelvis.translation());
+  o.headRadius = f.headR; o.hasHelmet = !!f.hasHelmet;
+  _lq.set(headQ.x, headQ.y, headQ.z, headQ.w);
+  put(o.neck, _lp.set(0, FINISH.neckAt, 0).applyQuaternion(_lq).add(_bp.set(head.x, head.y, head.z)));
+  put(o.face, _lp.set(VITAL.faceLocalX, VITAL.faceLocalY, 0).applyQuaternion(_lq).add(_bp.set(head.x, head.y, head.z)));
+  o.bladeBase = f.armed ? put(B[0], f.bladePoint(0, _lp)) : null;
+  o.bladeTip = f.armed ? put(B[1], f.bladePoint(1, _lp)) : null;
+  return o;
