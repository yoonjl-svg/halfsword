+++ b/tools/sim/pair_report.mjs
@@ -0,0 +1,58 @@
+// ─────────────────────────────────────────────────────────────
+//  pair_report.mjs — 다리 반작용 쌍(src/leg_pair.js · 물리 2.0 시제품 11/24)의 등가 관절 토크 · 한도에 닿은 몫 · 요구 가운데 못 건 몫을 장면마다 찍는다.
+//   node tools/sim/pair_report.mjs [--scenes=stand,walk,walkstop,strafe,back,kick,stroke] [--weapon=longsword] [--kick=40] [--seed=7]
+//  심판 도구 honesty.mjs 와 같은 대본(자리 잡기 3 s 뒤 · 걷기 4 s · 걷다 서기 2.5 + 2.5 s · 가슴 밀기 1 s 뒤 · 빗겨 베기 여섯 획). 재기만 한다.
+//  '쌍 몫' = 쌍(골반 ↔ 딛은 발 힘 · 토크)과 같은 일을 하는 관절 토크(야코비 전치) — 이 값에 사람 한도 × 근력을 건다.
+//  '다리 몫 더한 어림' = 다리 관절 모터가 싣는 땅 반력(수직은 접촉에서 · 수평은 운동량에서 잰 값)까지 더한 것 — 가벼운 다리의 정역학 어림.
+// ─────────────────────────────────────────────────────────────
+import * as H from './harness_m.mjs';
+import { legPairReport } from '../../src/leg_pair.js';
+
+const args = Object.fromEntries(process.argv.slice(2).map((a) => { const m = a.match(/^--([^=]+)(?:=(.*))?$/); return m ? [m[1], m[2] ?? true] : [a, true]; }));
+const FAM = { diagR: { ch: [0.42, 0.42], end: [-0.4, -0.42], v: 12 } };
+const weapon = String(args.weapon ?? 'longsword');
+const kickN = +(args.kick ?? 40);
+for (const sc of String(args.scenes ?? 'stand,walk,walkstop,strafe,back,kick,stroke').split(',')) {
+  const G = H.newRound({ walls: false, weapon, seed: +(args.seed ?? 7) });
+  G.park();
+  const P = G.player;
+  const F = sc === 'stroke' ? FAM.diagR : null;
+  if (F) P.handOffset.set(F.ch[0], F.ch[1]);
+  let tgt = F ? F.end : null, hold = 0, fell = null;
+  const secs = 3 + (sc === 'walkstop' || sc === 'kick' ? 5 : sc === 'stroke' ? 4.2 : 4);
+  for (let i = 0; i < Math.round(secs / H.DT); i++) {
+    const t = i * H.DT;
+    P.move.set(0, 0);
+    if (t >= 3) {
+      if (sc === 'walk' || (sc === 'walkstop' && t < 5.5)) P.move.set(0, 1);
+      if (sc === 'back') P.move.set(0, -1);
+      if (sc === 'strafe') P.move.set(1, 0);
+      if (F) {
+        const off = P.handOffset, dx = tgt[0] - off.x, dy = tgt[1] - off.y, d = Math.hypot(dx, dy), st = F.v * H.DT;
+        if (d > st) { off.x += (dx / d) * st; off.y += (dy / d) * st; } else { off.set(tgt[0], tgt[1]); hold += H.DT; if (hold >= 0.6) { hold = 0; tgt = tgt === F.end ? F.ch : F.end; } }
+      }
+    }
+    if (sc === 'kick' && Math.abs(t - 4) < H.DT / 2) {
+      const r = P.bodies.pelvis.rotation();
+      const fw = new H.THREE.Vector3(1, 0, 0).applyQuaternion(new H.THREE.Quaternion(r.x, r.y, r.z, r.w));
+      P.bodies.chest.applyImpulse({ x: -fw.x * kickN, y: 0, z: -fw.z * kickN }, true);
+    }
+    if (Math.abs(t - 3) < H.DT / 2 && P.legPair) { // 재기 시작: 자리 잡는 동안의 통계는 버린다
+      const S = P.legPair.stat;
+      for (const k of Object.keys(S)) { const v = S[k]; if (v?.hist) { v.hist.fill(0); v.n = v.sat = v.peak = 0; } }
+      S.steps = S.on = S.single = S.double = S.peakN = 0;
+      for (const k of Object.keys(S.clip)) S.clip[k] = 0;
+      for (const o of [S.lost, S.want, S.got]) for (const k of Object.keys(o)) o[k] = 0;
+    }
+    G.step();
+    if (t >= 3 && fell == null && (P.state !== 'stand' || P.bodies.pelvis.translation().y < 0.5)) fell = +(t - 3).toFixed(2);
+  }
+  const R = legPairReport(P);
+  const row = (o, key) => Object.entries(o).map(([k, v]) => `${k} ${v.p95}/${v.peak}(${(100 * v[key]).toFixed(1)}%)`).join(' · ');
