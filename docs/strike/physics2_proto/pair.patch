+  // 수직 반력(다리 몫 L 은 발목 밑 a · 쌍 몫은 c)이 무게중심 둘레에 만드는 모멘트: (p − R) × V·ŷ = (−(p.z − R.z)·V, 0, (p.x − R.x)·V)
+  //  + 다리 관절이 전하는 수평 힘 G (땅 높이에 걸림 → (−h·G_z, 0, h·G_x))
+  let m0x = -h * Gl.z, m0z = h * Gl.x;
+  for (const s of feet) {
+    m0x += -(s.a.z - R.z) * s.L - (s.c.z - R.z) * s.f.y;
+    m0z += (s.a.x - R.x) * s.L + (s.c.x - R.x) * s.f.y;
+  }
+  // 두 발 디딤: 수직 힘 차 δ (발 0 에 +δ · 발 1 에 −δ) 가 내는 모멘트 = δ·|D|·e,  e = (−D̂.z, 0, D̂.x)
+  let ex = 0, ez = 0, dl = 0, dLo = 0, dHi = 0, delta = 0;
+  if (n === 2) {
+    const dx = feet[0].c.x - feet[1].c.x, dz = feet[0].c.z - feet[1].c.z;
+    dl = Math.hypot(dx, dz);
+    if (dl > 0.05) {
+      ex = -dz / dl;
+      ez = dx / dl;
+      dLo = -(feet[0].f.y + LEGPAIR.pull * feet[0].L);
+      dHi = feet[1].f.y + LEGPAIR.pull * feet[1].L;
+    } else dl = 0;
+  }
+  const useDelta = (mx, mz) => {
+    // (mx, mz) 가운데 e 쪽 몫을 δ 로 댄다 → 못 댄 나머지를 _rem 에
+    _rem.x = mx;
+    _rem.z = mz;
+    if (!dl) return;
+    const want = (mx * ex + mz * ez) / dl;
+    const d1 = clamp(delta + want, dLo, dHi);
+    const got = d1 - delta;
+    if (Math.abs(got - want) > 1e-9) stat.clip.pull++;
+    delta = d1;
+    _rem.x -= got * dl * ex;
+    _rem.z -= got * dl * ez;
+  };
+  const setNp = () => {
+    for (let i = 0; i < n; i++) feet[i].Np = Math.max(0, feet[i].L + feet[i].f.y + (dl ? (i === 0 ? delta : -delta) : 0));
+  };
+  // ② 진자 몫: −m0 을 힘 차로, 남으면 알짜 수평 힘으로 (지면에 건 수평 힘 F 의 무게중심 둘레 모멘트 = (−h·F_z, 0, h·F_x))
+  const ff = LEGPAIR.loadFF;
+  useDelta(-m0x * ff, -m0z * ff);
+  let Fhx = _rem.z / h, Fhz = -_rem.x / h;
+  const Fpx = Fhx, Fpz = Fhz; // 진자 몫 (관절 한도에서 받침과 한 덩어리로 다룬다)
+  // ③ 세우기: 힘 차 → 발 토크 → 남으면 hipTilt 까지만 수평 힘
+  useDelta(W.tau.x, W.tau.z);
+  setNp();
+  footTorque(feet, _rem.x, _rem.z, stat);
+  {
+    const r = Math.hypot(_rem.x, _rem.z);
+    const q = r > LEGPAIR.hipTilt ? LEGPAIR.hipTilt / r : 1;
+    if (q < 1) stat.clip.hip++;
+    Fhx += (_rem.z * q) / h;
+    Fhz += (-_rem.x * q) / h;
+    stat.want.tilt += Math.hypot(W.tau.x, W.tau.z) * dt;
+    stat.got.tilt += r * (1 - q) * dt; // 못 댄 몫
+  }
+  // ④ 걷기 밀기: 바라는 알짜 수평 힘과의 차 ΔF — 그 힘의 모멘트 (−h·ΔF_z, 0, h·ΔF_x) 를 힘 차 · 발 토크가 지울 수 있는 만큼만
+  {
+    const dFx = W.fx - Fhx - Gl.x, dFz = W.fz - Fhz - Gl.z; // 바라는 것은 땅 수평 힘 전체 (다리 몫 G + 쌍 몫)
+    useDelta(h * dFz, -h * dFx); // 순수 모멘트 쪽이 대야 할 몫 = 그 힘의 모멘트의 반대
+    setNp();
+    footTorque(feet, _rem.x, _rem.z, stat);
+    // 못 지운 모멘트 u 만큼의 힘은 걸지 않는다: ΔF_u = (−u_z/h, u_x/h)
+    const ux = _rem.x, uz = _rem.z;
+    if (Math.abs(ux) + Math.abs(uz) > 1e-6) stat.clip.push++;
+    Fhx += dFx + uz / h;
+    Fhz += dFz - ux / h;
+    stat.want.push += Math.hypot(W.fx, W.fz) * dt;
+    stat.got.push += Math.hypot(W.fx - Fhx - Gl.x, W.fz - Fhz - Gl.z) * dt; // 못 건 몫
+  }
+  setNp();
+  // 수평 힘을 발의 법선 몫대로 나누고, 수직 힘 차 · 발 토크를 월드로
+  let Nps = 0;
+  for (const s of feet) Nps += s.Np + 1e-6;
+  for (let i = 0; i < n; i++) {
+    const s = feet[i];
+    const w = (s.Np + 1e-6) / Nps;
+    s.f.x = Fhx * w;
+    s.f.z = Fhz * w;
+    s.p.set(Fpx * w, 0, Fpz * w);
+    if (dl) s.f.y += i === 0 ? delta : -delta;
+    s.t.copy(s.tl).applyQuaternion(s.q);
+    s.t.y = 0;
+  }
+  // ⑤ 돌리기: 수평 힘 나눔이 이미 만든 수직축 모멘트를 빼고, 두 발 수평 힘쌍 → 발바닥 비틀기
+  {
+    let my = W.tau.y;
+    for (const s of feet) my -= (s.c.z - R.z) * s.f.x - (s.c.x - R.x) * s.f.z;
+    stat.want.yaw += Math.abs(W.tau.y) * dt;
+    if (dl) {
+      // 발 0 에 +g·n̂ · 발 1 에 −g·n̂,  n̂ = (D̂.z, 0, −D̂.x) → 수직축 모멘트 g·|D|. 한도: 두 발의 남은 마찰 여유
+      const nx = -ex, nz = -ez;
+      let g = my / dl;
+      let gMax = Infinity;
+      for (const s of feet) gMax = Math.min(gMax, Math.max(0, mu * s.Np * LEGPAIR.yawShare - Math.hypot(s.f.x, s.f.z)));
+      if (Math.abs(g) > gMax) { g = Math.sign(g) * gMax; stat.clip.yaw++; }
+      feet[0].f.x += g * nx; feet[0].f.z += g * nz;
+      feet[1].f.x -= g * nx; feet[1].f.z -= g * nz;
+      my -= g * dl;
+    }
+    let Ns = 0;
+    for (const s of feet) Ns += s.Np + 1e-6;
+    let left = my;
+    for (const s of feet) {
+      // 발바닥 비틀기: 마찰 한도와 발목 · 엉덩이 돌림 근력 한도 가운데 작은 쪽 (이 토크는 발목 · 무릎 · 엉덩이를 그대로 지난다)
+      const cap = Math.min(mu * s.Np * LEGPAIR.yawArm, 0.9 * s.str * Math.min(LEGPAIR.limit.ankleRot, LEGPAIR.limit.hipRot));
+      const ty = clamp((my * (s.Np + 1e-6)) / Ns, -cap, cap);
+      s.t.y = ty;
+      left -= ty;
+    }
+    if (Math.abs(left) > 1e-6) stat.clip.yaw++;
+    stat.got.yaw += Math.abs(left) * dt;
+  }
+  // ⑥ 마찰 원뿔 ⑦ 관절 한도 → 건다
+  let sx = 0, sz = 0, scAll = 1, scH = 1;
+  for (const s of feet) {
+    const fh = Math.hypot(s.f.x, s.f.z), fhMax = mu * s.Np;
+    if (fh > fhMax) { const q = fhMax / (fh + 1e-12); s.f.x *= q; s.f.z *= q; s.p.multiplyScalar(q); stat.clip.friction++; }
+    scAll = Math.min(scAll, jointScale(f, s.l, s, s.str, stat, false, 0, 0).all);
+  }
+  if (scAll < 1) for (const s of feet) { s.f.multiplyScalar(scAll); s.p.multiplyScalar(scAll); s.t.multiplyScalar(scAll); }
+  for (const s of feet) scH = Math.min(scH, jointScale(f, s.l, s, s.str, stat, false, 0, 0).h);
+  // 한 발이 한도에 닿으면 모든 발의 쌍을 같은 배율로 줄인다 (발마다 따로 줄이면 두 발의 힘 차 · 힘쌍이 짝을 잃어 골반을 엉뚱하게 당긴다).
+  //  진자 몫 밖의 수평 힘 때문에 넘으면 그 몫만(scH), 받침 · 진자 몫 · 토크만으로도 넘으면 전부(scAll)
