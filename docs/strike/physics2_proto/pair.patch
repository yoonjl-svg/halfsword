+  if (up > 0 && (sx !== 0 || sz !== 0)) {
+    const chest = f.bodies.chest;
+    const C = chest.worldCom();
+    _F.x = up * sx; _F.y = 0; _F.z = up * sz;
+    chest.addForce(_F, true);
+    _P.x = C.x; _P.y = C.y; _P.z = C.z;
+    _F.x = -up * sx; _F.z = -up * sz;
+    pel.addForceAtPoint(_F, _P, true);
+  }
+}
+
+/** 재는 쪽이 읽는 요약: 등가 관절 토크(다리 하중 + 쌍)의 95 % · 최고 · 한도에 닿은 몫 (발-스텝 기준) · 요구 가운데 못 건 몫 */
+export function legPairReport(f) {
+  const st = f.legPair;
+  if (!st) return null;
+  const S = st.stat;
+  const r1 = (x) => +x.toFixed(1);
+  const out = {
+    steps: S.steps, onShare: +(S.on / Math.max(1, S.steps)).toFixed(3), single: S.single, double: S.double, clip: { ...S.clip }, peakN: r1(S.peakN),
+    lostNs: r1(S.lost.F), lostNms: r1(S.lost.T),
+    pushWantNs: r1(S.want.push), pushMissNs: r1(S.got.push), tiltWantNms: r1(S.want.tilt), tiltMissNms: r1(S.got.tilt), yawWantNms: r1(S.want.yaw), yawMissNms: r1(S.got.yaw),
+    joints: {},
+  };
+  for (const k of STAT_KEYS) {
+    const J = S[k];
+    let acc = 0, p95 = 0;
+    for (let i = 0; i < NBIN; i++) {
+      acc += J.hist[i];
+      if (acc >= 0.95 * J.n) { p95 = (i + 1) * BIN; break; }
+    }
+    out.joints[k] = { p95, peak: r1(J.peak), satShare: +(J.sat / Math.max(1, J.n)).toFixed(4) };
+  }
+  // 다리 관절 모터가 싣는 몫까지 더한 어림 (가벼운 다리의 정역학 — 한도를 넘는 몫은 쌍이 아니라 다리 모터 쪽 문제)
+  out.jointsAll = {};
+  for (const k of STAT_KEYS) {
+    const J = S[k + 'All'];
+    let acc = 0, p95 = 0;
+    for (let i = 0; i < NBIN; i++) {
+      acc += J.hist[i];
+      if (acc >= 0.95 * J.n) { p95 = (i + 1) * BIN; break; }
+    }
+    out.jointsAll[k] = { p95, peak: r1(J.peak), overShare: +(J.sat / Math.max(1, J.n)).toFixed(4) };
+  }
+  return out;
+}
