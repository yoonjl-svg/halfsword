+    const fb = f.bodies[l.foot];
+    _P.x = s.c.x; _P.y = s.c.y; _P.z = s.c.z;
+    _F.x = s.f.x; _F.y = s.f.y; _F.z = s.f.z;
+    pel.addForceAtPoint(_F, _P, true);
+    _F.x = -s.f.x; _F.y = -s.f.y; _F.z = -s.f.z;
+    fb.addForceAtPoint(_F, _P, true);
+    if (s.t.x !== 0 || s.t.y !== 0 || s.t.z !== 0) {
+      _F.x = s.t.x; _F.y = s.t.y; _F.z = s.t.z;
+      pel.addTorque(_F, true);
+      _F.x = -s.t.x; _F.y = -s.t.y; _F.z = -s.t.z;
+      fb.addTorque(_F, true);
+    }
+    sx += s.f.x; sz += s.f.z;
+    st.net.add(s.f);
