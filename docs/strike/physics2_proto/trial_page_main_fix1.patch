+          test -f .p2/tools/physics2_page/build.mjs
           cd .p2
           npm ci
           node tools/physics2_page/build.mjs "$RUNNER_TEMP/physics2"
           rm -rf ../public/physics2
           cp -r "$RUNNER_TEMP/physics2" ../public/physics2
       - run: npm run build
