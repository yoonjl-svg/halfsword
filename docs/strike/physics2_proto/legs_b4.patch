+      if (fh > mu * N) { Fx *= (mu * N) / fh; Fz *= (mu * N) / fh; d.slipN++; }
+    }
+    d.N = N; d.Fx = Fx; d.Fz = Fz; d.Mx = Mx; d.My = My; d.Mz = Mz;
+    // ── 3) 발마다 ──
+    if (on.length === 2) {
+      const A = on[0], B = on[1];
+      const NA = N * wA, NB = N * (1 - wA);
+      const Dx = A.c.x - B.c.x, Dz = A.c.z - B.c.z;
+      const Lf = Math.hypot(Dx, Dz) || 1e-6;
+      const ux = Dx / Lf, uz = Dz / Lf;
