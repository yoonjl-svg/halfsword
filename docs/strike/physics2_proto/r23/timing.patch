+// ─────────────────────────────────────────────────────────────
+//  치기 박자 — 손 · 칼 · 발의 차례 (물리 2.0 r23 T1 · docs/strike/physics2_notes/r23_timing.md)
+//   사람 몸과 AI 몸이 같은 이 한 곳을 읽는다. 값은 config.js STRIKE_TIMING (기본 칸 + 유파 칸).
+//   찌르기: 손이 먼저 — 걸음 부탁은 탭이 아니라 팔이 뻗기 시작한 때(THRUST.aim 끝)에서 잰다.
+//   베기: 칼이 먼저 — 앞발은 칼이 닿은 뒤에 딛는다.
+//   유파 칸(STRIKE_TIMING.school[유파])이 있으면 그 유파 값, 없으면 기본 칸. 켜고 끄는 깃발 없음 — 값 하나가 차례를 정한다
+//   (thrustStep 이 −THRUST.aim 이면 옛 '탭과 같은 때 걸음' = 발 먼저).
+// ─────────────────────────────────────────────────────────────
+import { STRIKE_TIMING } from './config.js';
+
+const _merged = new Map(); // 유파 칸 → 기본 칸을 덮은 칸 (유파마다 한 번 만듦 · 칸 객체가 바뀌면 다시)
+
+/** 이 몸의 박자 칸 (유파 칸이 있으면 그 값이 기본 칸을 덮음) */
+export function timingOf(f) {
+  const k = f?.swordArt?.tradition;
+  const s = k != null ? STRIKE_TIMING.school[k] : null;
+  if (!s) return STRIKE_TIMING.base;
+  let m = _merged.get(s);
+  if (!m || m.base !== STRIKE_TIMING.base) _merged.set(s, (m = { base: STRIKE_TIMING.base, T: { ...STRIKE_TIMING.base, ...s } }));
+  return m.T;
+}
+
+/** 찌르기 걸음을 부탁할 때 (찌르기 시계 tap.t · 초): 팔이 뻗기 시작한 때(K.aim) + thrustStep */
+export function thrustStepAt(f, K) {
+  return Math.max(0, K.aim + timingOf(f).thrustStep);
+}
+
+/** 칼이 나간 뒤 걸음을 부탁하기까지 (초 · AI 기술 칼 — 자세 지도 길): 찌르기는 칼이 나감 = 팔이 뻗기 시작 → thrustStep · 베기 → cutStep */
+export function strikeStepDelay(f, kind) {
+  const T = timingOf(f);
+  return Math.max(0, kind === 'thrust' ? T.thrustStep : T.cutStep);
+}
+
+
+/** 당김이 끝났다고 보는 손 빠르기 (m/s · 칼자루가 칼 선을 따라 뒤로) — 이보다 느려지면 뻗기 시작 */
+export function chamberV(f) {
+  return timingOf(f).chamberV;
+}
