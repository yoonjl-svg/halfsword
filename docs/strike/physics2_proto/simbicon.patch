+//
+//   근육 = 엔진 관절 모터(관절 공간 PD · fighter.driveJoints) + 여기서 거는 명시 토크 쌍.
+//   ① 골반 자세(기울기 · yaw)는 세계 틀에서 잡는다: 디딘 다리의 엉덩이 목표를 '실제 골반'이 아니라 '바라는 골반 자세' 기준으로 준다(gait.legIK).
+//      그러면 골반이 기울거나 돌아간 만큼이 디딘 엉덩이 모터의 오차가 되고, 그 반작용은 디딘 다리 → 발 → 땅으로 간다(τ_디딘 엉덩이 = −τ_몸통).
+//      내딛는 다리의 엉덩이는 전처럼 세계 틀 목표(실제 골반 기준으로 풀어 줌).
+//   ② 빠르기 · 균형은 발 놓기 되먹임으로: 디딜 자리 = 몸이 디딜 때 있을 곳 + 실제 속도 몫 + (실제 − 가려는 속도) 몫 (gait.target).
+//   ③ 작은 고침은 압력 중심으로: 바라는 무게중심 가속(gait.update) → 압력 중심 자리 = 발목 토크 + 두 발 하중 몫 (이 파일 stanceFF). 발바닥 밖으로는 못 나간다.
+//   ④ 디딘 다리 중력 보상 앞먹임(stanceFF): 그 압력 중심에서 무게중심 쪽으로 향하는 땅 반력(크기 = 그 다리 하중 몫 × 몸무게)을
+//      내려면 필요한 발목 · 무릎 · 엉덩이 토크를 명시 쌍으로 건다 — PD 가 처지지 않게.
+//   ⑤ 내딛는 발 이끌기(swingTorque): 옛 swingPull(발과 골반에 작용선이 다른 힘 → 짝 없는 짝힘)을 엉덩이 · 무릎 토크 쌍(야코비 전치)으로.
+//   모든 명시 토크는 사람 한도(config POSE.torque × 근육 몫) 안으로 자르고, 암시 모터는 남은 예산 안에서 '크기 합 줄이기'로 묶는다. 포화는 fighter.torqueLog 에 센다.
+// ─────────────────────────────────────────────────────────────
+import * as THREE from 'three';
+import { POSE } from './config.js';
+
+const clamp = THREE.MathUtils.clamp;
+const AXES = ['x', 'y', 'z'];
+const LEG_PARTS = ['thighF', 'shinF', 'footF', 'thighB', 'shinB', 'footB'];
+const KNEE_LOCAL = new THREE.Vector3(0, -0.215, 0); // 허벅지 몸체 기준 무릎 관절 자리
+const SOLE_LOCAL = new THREE.Vector3(0, -0.035, 0); // 발 몸체 기준 발바닥 가운데
+
+/** 세계 풀이 값 (세계마다 한 번 — 싸움꾼이 만들어질 때 부른다. 사람 · AI 가 같은 세계 · 같은 몸 물리) */
+const TUNED = new WeakSet();
+export function tuneWorld(world) {
+  if (TUNED.has(world)) return;
+  TUNED.add(world);
+  const ip = world.integrationParameters;
+  ip.numInternalPgsIterations = POSE.pgs;
+  ip.contact_natural_frequency = POSE.contactHz;
+}
+
+/** 관절 이름 → 사람 토크 한도 표 (없으면 null — 팔 · 목 · 칼은 fighter 의 옛 표 그대로) */
+export function torqueLimit(name) {
+  const T = POSE.torque;
+  if (name.startsWith('thigh')) return T.thigh;
+  if (name.startsWith('shin')) return T.shin;
+  if (name.startsWith('foot')) return T.foot;
+  return T[name] ?? null;
+}
+
+/** 다리 근육 몫 (fighter.driveJoints 의 다리 식과 같은 값): 근육 세기 × 다리 기능 */
+export function legMuscle(f, k) {
+  return Math.max(0.15, f.muscle) * (0.6 + 0.4 * f.legHealth) * (0.4 + 0.6 * f.limbs['leg' + k]);
+}
+
+/** 관절 토크 기록 칸 (관절마다 — 포화 셈 · 최고 · 크기 분포 5 N·m 칸) */
+function logOf(f, name) {
+  const L = (f.torqueLog ??= {});
+  return (L[name] ??= { n: 0, ffSat: 0, pdSat: 0, peak: 0, sum: 0, hist: new Uint32Array(100) });
+}
+
+/** 스텝 처음: 명시 토크가 쓴 몫을 지운다 (driveJoints 가 남은 예산을 읽는다) */
+export function beginTorques(f) {
+  for (const j of f.joints) {
+    if (!j.tlim) continue;
+    j.ff.x = j.ff.y = j.ff.z = 0;
+    j.ffHit = false;
+  }
+}
+
+/**
+ * 관절 j 에 명시 토크 쌍을 건다: 자식 토막에 +τ · 부모 토막에 −τ (세계 틀 τ). 부모 틀 축마다 사람 한도 × 근육 몫 안으로 자른다(경첩은 z 축 몫만).
+ *  j.ff 에 쓴 몫(절댓값)을 쌓는다 — 암시 모터의 예산에서 뺀다.
+ */
+export function torquePair(j, tau, mus) {
+  const lim = j.tlim;
+  const r = j.parent.rotation();
+  _qp.set(r.x, r.y, r.z, r.w);
+  _tl.copy(tau).applyQuaternion(_qi.copy(_qp).invert());
+  for (const ax of AXES) {
+    const m = lim[ax] == null ? 0 : Math.max(0, lim[ax] * mus - j.ff[ax]);
+    if (Math.abs(_tl[ax]) > m) {
+      if (lim[ax] != null) j.ffHit = true;
+      _tl[ax] = clamp(_tl[ax], -m, m);
+    }
+    j.ff[ax] += Math.abs(_tl[ax]);
+  }
+  _tl.applyQuaternion(_qp);
+  _t.x = _tl.x; _t.y = _tl.y; _t.z = _tl.z;
+  j.child.addTorque(_t, true);
+  _t.x = -_tl.x; _t.y = -_tl.y; _t.z = -_tl.z;
+  j.parent.addTorque(_t, true);
+}
+
+/**
+ * ④ 디딘 다리 중력 보상 앞먹임 + 압력 중심(발목 토크 · 두 발 하중 몫)으로 하는 균형의 작은 고침.
+ *  바라는 무게중심 수평 가속 a(gait.acc)에서 바라는 압력 중심 P* = 무게중심 − a ÷ ω0² 를 구한다(거꾸로 선 진자: 가속 = ω0² × (무게중심 − 압력 중심)).
+ *  두 발 디딤이면 P* 를 두 발바닥 가운데를 잇는 선에 내려 하중 몫 w 를 정하고(선 위 자리), 남는 몫은 발마다 발바닥 안(POSE.copX · copZ)에서 압력 중심을 옮긴다.
+ *  한 발 디딤이면 그 발바닥 안에서만. 발마다 압력 중심 P 에서 무게중심 쪽을 향하는 땅 반력 G = w · M·g · 근육 몫 · (수평 ÷ 높이, 1) 을 내는 관절 토크를 건다:
+ *   관절 J 에서 먼 쪽 토막에 거는 근육 토크 = −(P − J) × G (땅이 주는 모멘트와 맞비김), 가까운 쪽 토막에 그 반대.
+ *  반력이 무게중심을 향하므로 몸에 모멘트를 주지 않고, 수평 몫이 곧 진자의 가속이다(마찰이 실제로 받는다 — 못 받으면 미끄러진다).
+ *  P* 가 발 밖이면 발 가장자리에서 잘린다 = 발목 · 하중 몫으로는 못 버틴다 → 발 놓기(gait.target · 균형 걸음)가 맡는다.
+ */
+export function stanceFF(f, dt) {
+  const G = f.gait;
+  if (!G?.active || f.state !== 'stand' || !f.com) {
+    if (G) G.legs.F.w = G.legs.B.w = 0;
+    return;
+  }
+  const J = f.jointByName;
+  const Mg = f.totalMass * 9.81;
+  const c = f.com;
+  const a = G.legs.F;
+  const b = G.legs.B;
+  // 발바닥 가운데 (땅 위) · 발 앞 방향
+  for (const l of [a, b]) {
+    (l.sole ??= new THREE.Vector3()).copy(SOLE_LOCAL).applyQuaternion(l.fq).add(l.fp);
+    l.sole.y = f.terrain ? f.terrain.heightAt(l.sole.x, l.sole.z) : 0;
+    (l.cop ??= new THREE.Vector3()).copy(l.sole);
+  }
+  const gy = f.terrain ? f.terrain.heightAt(c.x, c.z) : 0;
+  const w02 = 9.81 / Math.max(0.5, c.y - gy);
+  // 바라는 압력 중심 = 무게중심 − s · 가속 ÷ ω0². 받침 꼴(두 발바닥) 안에 들어오는 가장 큰 s (0 ~ 1)를 쓴다 — 받침 밖의 점을 가까운 가장자리로 그냥 당기면
+  //  가속 방향이 틀어진다(잰 것: 앞에서 맞아 뒷발로 버티는 동안 압력 중심이 무게중심 옆으로 3 cm 어긋나 몸이 옆으로 0.5 m/s 까지 밀려 넘어짐). 방향은 지키고 크기만 줄인다
+  const fits = (qx, qz) => {
+    let ua = a.stance ? 1 : 0;
+    let ub = b.stance ? 1 : 0;
+    if (a.stance && b.stance) {
+      const ex = a.sole.x - b.sole.x;
+      const ez = a.sole.z - b.sole.z;
+      const e2 = ex * ex + ez * ez;
+      ua = e2 > 1e-6 ? clamp(((qx - b.sole.x) * ex + (qz - b.sole.z) * ez) / e2, 0, 1) : 0.5;
+      ub = 1 - ua;
+    }
+    if (ua + ub < 1e-6) return true;
+    const ox = qx - (ua * a.sole.x + ub * b.sole.x);
+    const oz = qz - (ua * a.sole.z + ub * b.sole.z);
+    for (const l of [a, b]) {
+      if (!l.stance || (l === a ? ua : ub) < 0.02) continue;
+      const cy = Math.cos(l.footYaw);
+      const sy = -Math.sin(l.footYaw);
+      if (Math.abs(ox * cy + oz * sy) > POSE.copX + 1e-4 || Math.abs(-ox * sy + oz * cy) > POSE.copZ + 1e-4) return false;
+    }
+    return true;
+  };
+  const A_ = G.acc;
+  let sc = 1;
+  if (!fits(c.x - A_.x / w02, c.z - A_.z / w02)) {
+    let lo = 0;
+    let hi = 1;
+    for (let i = 0; i < 6; i++) {
+      const mid = (lo + hi) * 0.5;
+      if (fits(c.x - (mid * A_.x) / w02, c.z - (mid * A_.z) / w02)) lo = mid;
+      else hi = mid;
+    }
+    sc = lo;
+  }
+  G.accFit = sc; // (재기용: 바란 가속 가운데 받침이 낼 수 있던 몫)
+  const px = c.x - (sc * A_.x) / w02;
+  const pz = c.z - (sc * A_.z) / w02;
+  // 하중 몫: P* 의 두 발 사이 자리
+  let wa = a.stance ? 1 : 0;
+  let wb = b.stance ? 1 : 0;
+  if (a.stance && b.stance) {
+    const ex = a.sole.x - b.sole.x;
+    const ez = a.sole.z - b.sole.z;
+    const e2 = ex * ex + ez * ez;
+    wa = e2 > 1e-6 ? clamp(((px - b.sole.x) * ex + (pz - b.sole.z) * ez) / e2, 0, 1) : 0.5;
+    wb = 1 - wa;
+  }
+  a.wGeo = wa; // 바라는 몫 (접촉 여부를 보기 앞 — gait.poseLegs 의 하중 몫 맞추기가 읽는다: 아직 안 닿은 '디딘' 발은 닿을 때까지 다리를 늘인다)
+  b.wGeo = wb;
+  // 실제로 땅을 누르는 발만 (지난 스텝 접촉 힘): 뜬 발 몫은 다른 발로
+  const on = (l) => (l.stance ? clamp((l.N || 0) / (POSE.ffLoadOn * Mg), 0, 1) : 0);
+  const ca = on(a);
+  const cb = on(b);
+  const ta = ca * (wa + wb * (1 - cb));
+  const tb = cb * (wb + wa * (1 - ca));
+  const kf = Math.min(1, dt * POSE.ffRate);
+  a.w = (a.w || 0) + (ta - (a.w || 0)) * kf;
+  b.w = (b.w || 0) + (tb - (b.w || 0)) * kf;
+  if (!a.stance) a.w = 0;
+  if (!b.stance) b.w = 0;
+  // 남는 몫: P* − (하중 몫으로 정해진 자리) → 발마다 발바닥 안에서 압력 중심을 옮김
+  const ws = a.w + b.w;
+  const rx = ws > 1e-3 ? px - (a.w * a.sole.x + b.w * b.sole.x) / ws : 0;
+  const rz = ws > 1e-3 ? pz - (a.w * a.sole.z + b.w * b.sole.z) / ws : 0;
+  for (const l of [a, b]) {
+    if (!l.stance || !(l.w > 1e-3)) continue;
+    // 발 틀 (앞 · 옆)에서 자름
+    _v.set(1, 0, 0).applyQuaternion(l.fq);
+    const fl = Math.hypot(_v.x, _v.z) || 1;
+    const fx = _v.x / fl;
+    const fz = _v.z / fl;
+    const along = clamp(rx * fx + rz * fz, -POSE.copX, POSE.copX);
+    const side = clamp(-rx * fz + rz * fx, -POSE.copZ, POSE.copZ);
+    l.cop.x = l.sole.x + fx * along - fz * side;
+    l.cop.z = l.sole.z + fz * along + fx * side;
+    const mus = legMuscle(f, l.k);
+    const h = Math.max(0.4, c.y - l.cop.y);
+    let gx = (c.x - l.cop.x) / h;
+    let gz = (c.z - l.cop.z) / h;
+    const rr = Math.hypot(gx, gz);
+    if (rr > POSE.ffLeanMax) {
+      gx *= POSE.ffLeanMax / rr;
+      gz *= POSE.ffLeanMax / rr;
+    }
+    const N = l.w * Mg * Math.min(1, mus);
+    _G.set(gx * N, N, gz * N);
+    l.ffN = N;
+    // 발목
+    _m.subVectors(l.cop, l.ankle).cross(_G).negate();
+    torquePair(J[l.foot], _m, mus);
+    // 무릎 (경첩: 축 몫만 — torquePair 가 부모(허벅지) 틀 z 만 남긴다)
+    const tb2 = f.bodies[l.thigh];
+    const tr = tb2.rotation();
+    const tt = tb2.translation();
+    _k.copy(KNEE_LOCAL).applyQuaternion(_qk.set(tr.x, tr.y, tr.z, tr.w)).add(_v.set(tt.x, tt.y, tt.z));
+    _m.subVectors(l.cop, _k).cross(_G).negate();
+    torquePair(J[l.shin], _m, mus);
+    // 엉덩이
+    _m.subVectors(l.cop, l.hip).cross(_G).negate();
+    torquePair(J[l.thigh], _m, mus);
+  }
+}
+
+/**
+ * ⑤ 내딛는 발목에 힘 F 를 건 것과 같은 일을 하는 엉덩이 · 무릎 토크 쌍 (야코비 전치): 엉덩이(골반 ↔ 허벅지) τ = (발목 − 엉덩이) × F,
+ *  무릎(허벅지 ↔ 정강이) τ = ((발목 − 무릎) × F) 의 경첩 축 몫. 몸 전체로는 힘도 토크도 0 (토크 쌍뿐).
+ */
+export function swingTorque(f, l, F) {
+  const J = f.jointByName;
+  const mus = legMuscle(f, l.k);
+  const tb = f.bodies[l.thigh];
+  const tr = tb.rotation();
+  const tt = tb.translation();
+  _k.copy(KNEE_LOCAL).applyQuaternion(_qk.set(tr.x, tr.y, tr.z, tr.w)).add(_v.set(tt.x, tt.y, tt.z));
+  _m.subVectors(l.ankle, _k).cross(F);
+  torquePair(J[l.shin], _m, mus);
+  _m.subVectors(l.ankle, l.hip).cross(F);
+  // 수직축(yaw) 몫은 뺀다: 뻗은 다리의 발을 옆으로 미는 힘은 엉덩이에서 골반을 돌리는 반작용(잰 값: 한도 70 N·m 에 닿음)이 되는데, 한 발로 선 몸은 디딘 엉덩이 돌림근 하나(같은 70)로
+  //  그것을 못 버틴다(걷는 동안 골반 yaw 가 ± 0.5 rad 흔들림). 발의 옆 자리는 엉덩이 벌림 · 모음과 엔진 모터가 맡는다
+  _m.y = 0;
+  torquePair(J[l.thigh], _m, mus);
+}
+
+/** 암시 모터 한 축을 남은 예산 안으로: 스프링 몫 + 감쇠 몫의 크기 합이 예산을 넘으면 강성 · 감쇠를 같은 비율로 낮춘다 (엔진 시험 s5 (g) — 최고 1.02 ~ 1.38 배). 돌려주는 값 = 비율 */
+export function motorScale(spring, damp, budget) {
+  const need = Math.abs(spring) + Math.abs(damp);
+  return need > budget ? Math.max(1e-6, budget / need) : 1; // 0 은 축을 잠근다 (모터 k = d = 0 = 상대 각속도 0 구속) → 아주 작은 값
+}
+
+/** 스텝 끝(driveJoints 뒤): 관절마다 이번 스텝 요구 토크(명시 + 암시) 크기를 적는다 */
+export function logTorque(f, j, req, pdSat) {
+  const g = logOf(f, j.name);
+  g.n++;
+  if (j.ffHit) g.ffSat++;
+  if (pdSat) g.pdSat++;
+  g.sum += req;
+  if (req > g.peak) g.peak = req;
+  g.hist[Math.min(99, Math.floor(req / 5))]++;
+}
+
+/** 관절 토크 기록 요약: 이름 → { 평균, 95 %, 최고 (N·m), 앞먹임 포화 몫, 모터 포화 몫 } */
+export function torqueSummary(f) {
+  const out = {};
+  for (const [name, g] of Object.entries(f.torqueLog ?? {})) {
+    let acc = 0;
+    let p95 = 0;
+    for (let i = 0; i < 100; i++) {
+      acc += g.hist[i];
+      if (acc >= 0.95 * g.n) {
+        p95 = (i + 1) * 5;
+        break;
+      }
+    }
+    out[name] = { n: g.n, mean: +(g.sum / Math.max(1, g.n)).toFixed(1), p95, peak: +g.peak.toFixed(1), ffSat: +(g.ffSat / Math.max(1, g.n)).toFixed(4), pdSat: +(g.pdSat / Math.max(1, g.n)).toFixed(4) };
+  }
+  return out;
+}
+
+export { LEG_PARTS };
+
+const _qp = new THREE.Quaternion();
+const _qi = new THREE.Quaternion();
+const _qk = new THREE.Quaternion();
+const _tl = new THREE.Vector3();
+const _G = new THREE.Vector3();
+const _m = new THREE.Vector3();
+const _k = new THREE.Vector3();
+const _v = new THREE.Vector3();
+const _t = { x: 0, y: 0, z: 0 };
