+// ── EXP: swept (sub-stepped) blade-vs-part test between the pre-step pose (cache) and the post-step pose ──
+const _sq = new THREE.Quaternion();
+const _sp = new THREE.Vector3();
+const _off = new THREE.Vector3();
+function sweptPoint(c, bladeCol, partCol) {
+  const att = c.pr.w.fighter;
+  const S = att.cache?.sword;
+  if (!S) return null;
+  const sw = c.pr.w.body;
+  const p1 = tv(sw.translation());
+  const q1 = rotQ(sw);
+  _off.copy(tv(bladeCol.translation())).sub(p1).applyQuaternion(q1.clone().invert()); // blade collider offset in sword frame
+  const tip0 = new THREE.Vector3(0, att.weaponCfg.hiltLength + att.weaponCfg.bladeLength, 0).applyQuaternion(S.q).add(S.p);
+  const tip1 = new THREE.Vector3(0, att.weaponCfg.hiltLength + att.weaponCfg.bladeLength, 0).applyQuaternion(q1).add(p1);
+  const K = Math.min(16, Math.max(2, Math.ceil(tip0.distanceTo(tip1) / 0.03)));
+  const shape = bladeCol.shape;
+  for (let i = 0; i < K; i++) { // samples from s = 0 (pre-step pose) up to just before the post-step pose
+    const s = i / K;
+    _sq.copy(S.q).slerp(q1, s);
+    _sp.copy(S.p).lerp(p1, s);
+    const pos = _off.clone().applyQuaternion(_sq).add(_sp);
+    const sc = partCol.contactShape(shape, vp(pos), { x: _sq.x, y: _sq.y, z: _sq.z, w: _sq.w }, 0.004);
+    if (sc && sc.distance < 0.004) {
+      globalThis.__sweptUsed = (globalThis.__sweptUsed || 0) + 1;
+      return new THREE.Vector3(sc.point2.x, sc.point2.y, sc.point2.z);
+    }
+  }
+  return null;
+}
